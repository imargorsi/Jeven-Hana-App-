# Expo inlines EXPO_PUBLIC_* at bundle time (preferred).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Clerk CLI may write this name instead — also supported.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Backend API (Express on Vercel). Restart Expo / rebuild after changing.
# Bake this into release builds (EAS profiles already set it).
EXPO_PUBLIC_API_URL=https://api.jevanhana.argorsi.com

# Local API override (comment the Vercel URL above when using this):
# EXPO_PUBLIC_API_URL=http://localhost:3001

# HTTPS Privacy Policy for Play Console (defaults to API /privacy).
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://api.jevanhana.argorsi.com/privacy

# Production Play builds need a Clerk *live* publishable key (pk_live_...).
# Set via EAS secrets / env for production — never commit live keys.
# EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...

# Do NOT add CLERK_SECRET_KEY here. Secret keys belong on a server, not in the mobile app.

# Cloudflare R2 keys also stay on the API only (backend .env).
# Until R2 is configured, listing covers use the app logo fallback.
